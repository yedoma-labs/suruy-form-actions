{
  "name": "@yedoma-labs/suruy-form-actions",
  "version": "0.1.1",
  "description": "Type-safe form library for React Server Actions with progressive enhancement",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "keywords": [
    "react",
    "forms",
    "server-actions",
    "progressive-enhancement",
    "typescript",
    "validation",
    "nextjs"
  ],
  "author": "yedoma-labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yedoma-labs/suruy-form-actions.git"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "react": "^19.3.1",
    "semantic-release": "^25.0.9",
    "simple-git-hooks": "^2.14.0",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}
